# Optional: Free Live LLM Providers (Highly Recommended if HF credits are exhausted)
# Google Gemini API key (Free tier: gemini-2.0-flash / gemini-1.5-flash)
# GEMINI_API_KEY=your_gemini_api_key_here
# Groq API key (Free tier: llama-3.3-70b-versatile)
# GROQ_API_KEY=your_groq_api_key_here

# Hugging Face Access Token (Optional: requires paid inference credits on HF)
HF_TOKEN=your_huggingface_api_token_here

# Embedding Model Configuration (Default: BAAI/bge-m3)
EMBEDDING_MODEL=BAAI/bge-m3

# LLM Model Configuration (Default: Qwen/Qwen2.5-72B-Instruct)
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
# Set to 'true' to load Qwen2.5-VL locally via transformers & CUDA
USE_LOCAL_LLM=false

# Backend API URL for Streamlit
BACKEND_URL=http://127.0.0.1:8000

# File Paths
DATA_RAW_DIR=data/raw
PROCESSED_DATA_PATH=data/processed/chunks.json
FAISS_INDEX_PATH=data/faiss_index/index.faiss
FAISS_METADATA_PATH=data/faiss_index/metadata.json

