# ==========================================
# Bangladesh e-GP Official Manual Assistant
# Enterprise Multimodal RAG Environment Config
# ==========================================

# 1. LLM Configuration
HF_TOKEN=
LLM_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
ALT_VL_MODEL=LiquidAI/LFM2.5-VL-1.6B
USE_LOCAL_LLM=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=

# 2. Embedding Model
EMBEDDING_MODEL=BAAI/bge-m3

# 3. Retrieval Engine
VECTOR_DB=faiss
TOP_K=10

# 4. Service Hosts and Ports
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 5. Data and Index Paths
DATA_RAW_DIR=data/raw
PROCESSED_DATA_PATH=data/processed/chunks.json
FAISS_INDEX_PATH=data/faiss_index/index.faiss
FAISS_METADATA_PATH=data/faiss_index/metadata.json
