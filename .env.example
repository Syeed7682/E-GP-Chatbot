# Hugging Face Access Token (Optional: needed for live HF Inference API)
HF_TOKEN=your_huggingface_api_token_here

# Embedding Model Configuration (Default: BAAI/bge-m3)
EMBEDDING_MODEL=BAAI/bge-m3

# LLM Model Configuration (Default: Qwen/Qwen2.5-VL-72B-Instruct)
LLM_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
# Set to 'true' to load Qwen2.5-VL locally via transformers & CUDA
USE_LOCAL_LLM=false

# Backend API URL for Streamlit
BACKEND_URL=http://127.0.0.1:8000

# File Paths
DATA_RAW_DIR=data/raw
PROCESSED_DATA_PATH=data/processed/chunks.json
FAISS_INDEX_PATH=data/faiss_index/index.faiss
FAISS_METADATA_PATH=data/faiss_index/metadata.json

