# ==========================================
# Bangladesh e-GP Official Manual Assistant
# Enterprise Multimodal RAG Environment Config
# ==========================================

# 1. Hosted answer generation (keep provider keys on the backend)
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# 2. Optional Hugging Face token for embeddings
HF_TOKEN=

# Optional local Transformers model
USE_LOCAL_LLM=false
LOCAL_LLM_MODEL=Qwen/Qwen2.5-VL-3B-Instruct

# 3. Embedding Model
EMBEDDING_MODEL=BAAI/bge-m3

# 4. Retrieval Engine
VECTOR_DB=faiss
TOP_K=3

# 5. Service Hosts and Ports
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 6. Data and Index Paths (Legacy)
DATA_RAW_DIR=data/structured
PROCESSED_DATA_PATH=data/structured/metadata/pdf_manual.json
FAISS_INDEX_PATH=data/structured/indexes/pdf_manual.faiss
FAISS_METADATA_PATH=data/structured/metadata/pdf_manual.json

# 7. Render Production Storage & Upgraded RAG Settings
EGP_DATA_DIR=/var/data/egp
TEXT_MODEL=BAAI/bge-m3
VISUAL_MODEL=google/siglip-base-patch16-224
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
HF_HOME=/var/data/huggingface
INDEX_VERSION=active
TEXT_DIM=1024
VISUAL_DIM=768
TEXT_CHUNK_SIZE=450
TEXT_CHUNK_OVERLAP=60
