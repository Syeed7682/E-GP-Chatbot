# VITE_API_BASE_URL: Base URL of your existing FastAPI or backend server.
# For local development: http://127.0.0.1:8000 (or leave empty to use current domain/proxy)
# For Netlify deployment: Set in Netlify Dashboard -> Site settings -> Environment variables
VITE_API_BASE_URL=""

# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
